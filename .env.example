# Copie este archivo como .env y complete los valores. .env NUNCA se sube al repositorio.

# --- ERP ---
ERP_URL=http://xxx.xxx.xx.xxx:8000
ERP_TOKEN=
ERP_TIMEOUT=15

# --- IA ---
# gemini (gratis: https://aistudio.google.com/apikey) o claude (de pago: https://console.anthropic.com)
PROVEEDOR_IA=claude
GEMINI_API_KEY=
# Vacío = modelo por defecto del proveedor (gemini-3.8-flash / claude-opus-5-5)
MODELO_IA=
# Solo Gemini: modelos a probar si el principal está saturado (503) o con límite (429), separados por coma
MODELOS_RESPALDO=
ANTHROPIC_API_KEY=

# --- Correo: Gmail (opción principal) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=example1@gmail.com
# Contraseña de aplicación de Google (16 caracteres), no la clave normal
SMTP_PASSWORD=
CORREO_DESTINO=example2+homar@gmail.com

# --- Correo: buzón de prueba (solo si el evaluador lo indica) ---
# SMTP_HOST=192.168.15.113
# SMTP_PORT=1025
# SMTP_STARTTLS=false
# SMTP_USER=
# SMTP_PASSWORD=
# CORREO_REMITENTE=homar@prueba.local
# CORREO_DESTINO=avisos-homar@prueba.local

# --- Reglas de negocio ---
TASA_IVA=0.15
VALIDAR_TASA_IVA=true
TOLERANCIA=0.01
# igual = los montos de la factura deben coincidir con la OC | no_exceder = pueden ser menores (facturación parcial)
MODO_MONTO_OC=igual
